service udc /system/bin/udc.sh
    class main
    user root
    group root
    oneshot

service dnsmasq_rndis /system/bin/dnsmasq \
    --no-daemon \
    --interface=usb0 \
    --bind-interfaces \
    --dhcp-range=192.168.255.2,192.168.255.254,12h \
    --dhcp-option=3,192.168.255.1 \
    --log-queries \
    --no-resolv \
    --log-facility=/dev/log
    class main
    user root
    group root net_admin inet
    disabled
    oneshot

# sshd
service sshd /system/bin/dropbear -F -D /system/etc/dropbear
    class main
    user root
    group root shell log readproc
    restart
